{# Colors come from the active theme (themes.css: --i1 darkest … --i4 lightest). #}
{% if axis.id == "decode" %}
<svg viewBox="0 0 120 120" aria-hidden="true" class="axis-icon">
  <defs><radialGradient id="g-decode"><stop offset="0" style="stop-color:var(--i2)"/><stop offset="1" style="stop-color:var(--i2);stop-opacity:0"/></radialGradient></defs>
  <circle cx="34" cy="60" r="44" fill="url(#g-decode)" opacity=".55"/>
  <circle cx="34" cy="60" r="7" style="fill:var(--i1)"/>
  {% for x in [58, 72, 86, 100] %}{% set col = loop.index %}{% for y in [30, 46, 62, 78, 94] %}
  <circle cx="{{ x }}" cy="{{ y }}" r="4.2" style="fill:var(--i{{ col }})" opacity=".9"/>
  {% endfor %}{% endfor %}
</svg>
{% elif axis.id == "reprogram" %}
<svg viewBox="0 0 120 120" aria-hidden="true" class="axis-icon">
  <defs><linearGradient id="g-rep" x1="0" x2="1"><stop offset="0" style="stop-color:var(--i2)"/><stop offset="1" style="stop-color:var(--i4)"/></linearGradient></defs>
  <rect x="14" y="20" width="92" height="26" rx="13" fill="url(#g-rep)" opacity=".85"/>
  <rect x="14" y="74" width="92" height="26" rx="13" fill="url(#g-rep)" opacity=".85" transform="rotate(180 60 87)"/>
  <path d="M60 50 v18 m-7 -7 l7 7 l7 -7" stroke="#0b1220" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  <circle cx="30" cy="33" r="5" fill="#fff"/><circle cx="90" cy="87" r="5" fill="#fff"/>
</svg>
{% else %}
<svg viewBox="0 0 120 120" aria-hidden="true" class="axis-icon">
  <g fill="none" stroke-linecap="round">
    <path d="M60 104 C60 80 60 70 60 60 C60 44 38 40 30 22" style="stroke:var(--i1)" stroke-width="5"/>
    <path d="M60 60 C60 44 82 40 92 24" style="stroke:var(--i3)" stroke-width="5"/>
    <path d="M60 78 C70 72 88 72 100 62" style="stroke:var(--i4)" stroke-width="4" stroke-dasharray="2 8"/>
    <path d="M60 84 C48 78 30 80 20 70" style="stroke:var(--i2)" stroke-width="4" stroke-dasharray="2 8"/>
  </g>
  <circle cx="30" cy="22" r="7" style="fill:var(--i1)"/><circle cx="92" cy="24" r="7" style="fill:var(--i3)"/>
  <circle cx="100" cy="62" r="5" fill="none" style="stroke:var(--i4)" stroke-width="2.5"/><circle cx="20" cy="70" r="5" fill="none" style="stroke:var(--i2)" stroke-width="2.5"/>
</svg>
{% endif %}
