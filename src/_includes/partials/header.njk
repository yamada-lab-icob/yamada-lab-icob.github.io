<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <span class="brand-text">
        <span class="brand-name"><strong>Yamada</strong> <span class="brand-lab">Lab</span></span>
        <span class="brand-tag">{{ site.tagline }}</span>
      </span>
    </a>
    <button class="nav-toggle" aria-label="Menu"><span></span><span></span></button>
    <nav class="site-nav" aria-label="Main">
      {% for item in site.nav %}
        <a href="{{ item.url }}" {% if page.url.startsWith(item.url) %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
